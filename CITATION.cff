    family-names: Heindl
  - given-names: Jack
    family-names: Valmadre
  - given-names: Mikel
    family-names: Broström

keywords:
  - multiple object tracking
  - MOTChallenge
  - CLEAR MOT
  - identity metrics
  - HOTA
  - evaluation

